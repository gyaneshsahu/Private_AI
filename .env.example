# No secrets are loaded from this file. Set them securely in the process/environment.
# Existing services are not authorized for spending simply by copying this file.
PORT=4173
# Reviewed public hostnames only when this environment uses an HTTP(S) proxy.
PRIVATEAI_PUBLIC_FETCH_HOSTS=raw.githubusercontent.com
# Live chat remains disabled without a complete, unexpired evidence report.
PRIVATEAI_QUALIFICATION_FILE=.local/qualification.json
# TINFOIL_API_KEY=
# BRAVE_SEARCH_API_KEY=
# Hosted evaluation only: exact HTTPS origin (no trailing slash).
# PRIVATEAI_ORIGIN=https://your-development-host.example
# Set a random base64url access key of at least 32 characters in server secrets.
# Browser Basic Auth username is evaluator. Never use the provider key here.
# PRIVATEAI_ACCESS_KEY=
