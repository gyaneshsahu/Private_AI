# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS build
WORKDIR /app
COPY package.json package-lock.json ./
# Optional managed-environment CA, never copied into image layers.
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm ci --strict-ssl=true --no-audit --no-fund
COPY src ./src
COPY server ./server
COPY shared ./shared
COPY scripts/assets.mjs ./scripts/assets.mjs
# public/vendor is generated by npm run assets during the build.
COPY index.html tsconfig.json vite.config.ts ./
RUN npm run build

FROM build AS deployment-candidate
ENV NODE_ENV=production
USER node
EXPOSE 8443
STOPSIGNAL SIGTERM
ENTRYPOINT ["node", "--import", "tsx", "server/deployment-entry.ts"]
CMD ["/run/privateai/config.json"]

FROM deployment-candidate AS render-candidate
EXPOSE 10000
ENTRYPOINT ["node", "--import", "tsx", "server/render-entry.ts"]

CMD ["/etc/secrets/render-config.json"]
